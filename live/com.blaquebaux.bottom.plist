<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- bottom standalone sleeve. DRY-RUN by default (logs the target, places nothing) until
     ~/.config/blaquebaux/alpaca_bottom.env exists. Activate: cp to ~/Library/LaunchAgents/ and launchctl load. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.blaquebaux.bottom</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>/Users/malcolmx/blaquebaux-bottom/live/run_bottom_daily.sh</string></array>
  <key>StartCalendarInterval</key><array>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>26</integer></dict>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>36</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin</string></dict>
  <key>StandardOutPath</key><string>/Users/malcolmx/blaquebaux-bottom/logs/launchd_bottom.out</string>
  <key>StandardErrorPath</key><string>/Users/malcolmx/blaquebaux-bottom/logs/launchd_bottom.err</string>
</dict></plist>
